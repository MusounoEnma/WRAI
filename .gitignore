# =============================================================================
# WRAI .gitignore
# =============================================================================

# Large Model Weights & Checkpoints (>100MB, Host on Hugging Face / Releases)
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# Allow vocabulary binary (small, ~1.5 MB)
!*vocab.bin

# Large weights directories
models/
models x/
models x
1.7b models/
backups/

# Compiled Executables & Objects (build from source or download from Releases)
*.exe
*.o
*.obj
*.dll
*.so
*.dylib

# Compiler Toolchains & Archives
tools/w64devkit/
tools/w64devkit.zip
*.zip
*.tar.gz

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Logs & Temporary Scratch
*.log
scratch/
test_*.txt
test_*.exe

# IDE & OS
.vscode/
.idea/
Thumbs.db
.DS_Store

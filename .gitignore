# Standalone model weights & binaries (Host on Hugging Face Hub / GitHub Releases)
*.pt
*.bin
*.safetensors
standalone_models/

# Whitelist BananaMind 2 Micro embedded binaries (<3 MB, fits GitHub push)
!BananaMind 2 Micro/model/*.bin
!BananaMind 2 Micro/firmware/bin/*.bin

# Compiled native libraries & shared objects
*.so
*.dll
*.dylib
*.o
*.obj
*.exe

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Benchmark output logs & CSVs
*.csv
logs/

# Whitelist BananaMind 2 Micro audit validation CSVs
!BananaMind 2 Micro/audit/*.csv

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

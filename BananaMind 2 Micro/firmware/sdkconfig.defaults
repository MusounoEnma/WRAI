# ESP-IDF Configuration Defaults for BananaMind-2-Micro WRAI Deployment

# Flash Configuration (4MB Flash, DIO/QIO, 80MHz)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# CPU Frequency (240 MHz Max Clock)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Stack Size (16 KB for main task, internal static memory model)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Compiler Optimization for Pure Performance (-O3)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Disable Unnecessary Radios for Stable Benchmarking
CONFIG_BT_ENABLED=n
CONFIG_WIFI_ENABLED=n
